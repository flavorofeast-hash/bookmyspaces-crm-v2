# ── Required ───────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI)
CRM_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Any random text, 32+ characters (used to sign login sessions)
SESSION_SECRET=
# A code only you know, 8+ characters (needed once on the /setup page)
CRM_SETUP_CODE=
# This site's public address, e.g. https://bookmyspaces-crm-v2.vercel.app (customer document links, Instagram images)
APP_PUBLIC_URL=

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App → Settings → Basic → App secret. Required: unsigned webhook calls are rejected.
WHATSAPP_APP_SECRET=

# ── Facebook & Instagram publishing (optional) ─────────────────────────────
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Advanced (normally leave unset) ───────────────────────────────────────
# META_GRAPH_BASE=https://graph.facebook.com/v21.0
# CRM_DB_POOL_MAX=5
